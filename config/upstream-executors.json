{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Implementation mapping for registry-selected upstream sync jobs. This file contains execution mechanics only; source identity remains in upstream-registry.json.",
  "defaults": {
    "concurrency": 3,
    "shell": false,
    "timeoutMs": 900000
  },
  "jobs": [
    {
      "id": "islam-ummah",
      "name": "Islam (UmmahAPI)",
      "enabled": true,
      "endpointIds": ["ummah-api"],
      "script": "scripts/sync-ummah-upstream.ts",
      "required": false
    },
    {
      "id": "judaism-sefaria",
      "name": "Judaism (Sefaria)",
      "enabled": true,
      "endpointIds": ["sefaria-api"],
      "script": "scripts/sync-sefaria.ts",
      "required": false
    },
    {
      "id": "buddhism-suttacentral",
      "name": "Buddhism (SuttaCentral)",
      "enabled": true,
      "endpointIds": ["suttacentral-bilara"],
      "script": "scripts/sync-suttacentral.ts",
      "required": false
    },
    {
      "id": "chinese-classics",
      "name": "Chinese Classics (CText)",
      "enabled": true,
      "endpointIds": ["ctext-daoism", "ctext-confucianism"],
      "script": "scripts/sync-ctext.ts",
      "required": false
    },
    {
      "id": "universal-heritage",
      "name": "Universal Heritage", 
      "enabled": true,
      "endpointIds": [
        "gretil-vedic",
        "gita-open-data",
        "shabados",
        "jain-heritage",
        "bahai-library",
        "sacred-texts-shinto"
      ],
      "script": "scripts/fetch-upstream-scriptures.ts",
      "required": false
    }
  ]
}
