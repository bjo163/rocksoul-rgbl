{
  "name": "moonwitness-corpus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/core/src/*.test.ts packages/validator/src/*.test.ts",
    "validate": "tsx packages/validator/src/cli.ts",
    "todo:sync": "tsx scripts/sync-todo-issues.ts todo-to-issues",
    "todo:sync:issue": "tsx scripts/sync-todo-issues.ts issue-to-todo",
    "todo:check": "tsx scripts/sync-todo-issues.ts check",
    "check": "pnpm typecheck && pnpm test && pnpm validate"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "turbo": "^2.9.0",
    "typescript": "^5.9.0"
  }
}
