{
  "name": "moonwitness-corpus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build && tsx scripts/build-corpus.ts",
    "dev": "turbo run dev",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/*/src/*.test.ts apps/*/src/*.test.ts scripts/*.test.ts",
    "validate": "tsx packages/validator/src/cli.ts",
    "validate:upstream": "tsx scripts/validate-upstream-registry.ts",
    "validate:corpus": "tsx scripts/validate-corpus.ts",
    "validate:quality": "tsx scripts/validate-quality.ts",
    "validate:editions": "tsx scripts/validate-editions.ts",
    "validate:materialization": "tsx scripts/validate-materialization.ts",
    "materialize:editions": "tsx scripts/materialize-editions.ts",
    "audit:corpus": "tsx scripts/audit-corpus.ts",
    "audit:quality": "tsx scripts/audit-quality.ts",
    "audit:editions": "tsx scripts/audit-editions.ts",
    "audit:materialization": "tsx scripts/audit-materialization.ts",
    "compare:sources": "tsx scripts/compare-sources.ts",
    "report:corpus": "tsx scripts/report-corpus.ts",
    "report:quality": "tsx scripts/report-quality.ts",
    "report:editions": "tsx scripts/report-editions.ts",
    "audit:contributions": "tsx scripts/audit-contributions.ts",
    "validate:contributions": "tsx scripts/validate-contributions.ts",
    "report:depth": "tsx scripts/report-depth.ts",
    "analyze:editions": "tsx scripts/analyze-editions.ts",
    "report:materialization": "tsx scripts/report-materialization.ts",
    "report:materialization:delta": "tsx scripts/report-materialization-delta.ts",
    "reconcile:materialization": "tsx scripts/reconcile-materialization.ts",
    "discovery:workers": "tsx scripts/generate-discovery-workers.ts",
    "align:editions": "tsx scripts/align-editions.ts",
    "corpus:status": "tsx scripts/corpus-status.ts",
    "todo:sync": "tsx scripts/sync-todo-issues.ts todo-to-issues",
    "todo:sync:issue": "tsx scripts/reconcile-issue-status.ts",
    "todo:check": "tsx scripts/sync-todo-issues.ts check",
    "release:prepare": "tsx scripts/build-release.ts",
    "release:verify": "tsx scripts/verify-release.ts",
    "release:version": "tsx scripts/apply-release-plan.ts",
    "release:publish": "tsx scripts/publish-npm.ts",
    "release:publish:dry-run": "tsx scripts/publish-npm.ts --dry-run",
    "check": "pnpm build:sqlite && pnpm validate:upstream && pnpm validate:corpus && pnpm validate:quality && pnpm validate:editions && pnpm validate:materialization && pnpm validate:contributions && pnpm typecheck && pnpm test && pnpm validate && pnpm build",
    "check:release": "pnpm check && pnpm release:verify && pnpm release:publish:dry-run",
    "materialize:p5": "tsx scripts/materialize-p5-datasets.ts",
    "export:app-seeds": "tsx scripts/export-app-seeds.ts",
    "build:sqlite": "tsx scripts/build-sqlite-database.ts",
    "benchmark": "tsx scripts/benchmark-corpus.ts",
    "sync:all": "tsx scripts/sync-all-upstream.ts",
    "sync:upstream": "tsx scripts/sync-upstream-sources.ts",
    "sync:ummah": "tsx scripts/sync-ummah-upstream.ts",
    "upstream:list": "tsx scripts/upstream-manager.ts list",
    "upstream:audit": "tsx scripts/upstream-manager.ts audit",
    "fetch:upstream": "tsx scripts/fetch-upstream-scriptures.ts",
    "ingest:ummah": "tsx scripts/ingest-ummah-hadiths.ts",
    "serve": "tsx apps/api/src/server.ts",
    "api:dev": "pnpm --filter @moonwitness/corpus-api dev",
    "cli": "tsx packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@moonwitness/corpus-build": "workspace:*",
    "@moonwitness/corpus-core": "workspace:*",
    "@moonwitness/corpus-ingestion": "workspace:*",
    "@moonwitness/corpus-node": "workspace:*",
    "@moonwitness/corpus-repository": "workspace:*",
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "turbo": "^2.9.0",
    "typescript": "^5.9.0"
  }
}
