{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/assertion.schema.json",
  "type": "object",
  "required": ["id", "record_type", "subject", "predicate", "object", "assertion_class"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "record_type": { "const": "assertion" },
    "subject": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "predicate": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "object": {
      "oneOf": [
        { "type": "object", "required": ["entity"], "properties": { "entity": { "$ref": "common.schema.json#/$defs/canonicalId" } }, "additionalProperties": false },
        { "type": "object", "required": ["value"], "properties": { "value": { "type": ["string", "number", "boolean", "null"] }, "datatype": { "type": "string" }, "language": { "type": "string" } }, "additionalProperties": false }
      ]
    },
    "assertion_class": { "type": "string" },
    "scope": { "type": "object", "additionalProperties": { "type": "string" } },
    "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/canonicalId" } },
    "provenance": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false
}
