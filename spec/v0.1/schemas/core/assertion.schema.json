{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/assertion.schema.json",
  "type": "object",
  "required": ["id", "record_type", "subject", "predicate", "object", "assertion_class"],
  "properties": {
    "id": { "type": "string", "pattern": "^mw:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)+$" },
    "record_type": { "const": "assertion" },
    "subject": { "type": "string" },
    "predicate": { "type": "string" },
    "object": {
      "oneOf": [
        { "type": "object", "required": ["entity"], "properties": { "entity": { "type": "string" } }, "additionalProperties": false },
        { "type": "object", "required": ["value"], "properties": { "value": { "type": ["string", "number", "boolean", "null"] }, "datatype": { "type": "string" }, "language": { "type": "string" } }, "additionalProperties": false }
      ]
    },
    "assertion_class": { "type": "string" },
    "scope": { "type": "object", "additionalProperties": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "string" },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false
}
