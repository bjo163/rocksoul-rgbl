{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/assessment.schema.json",
  "type": "object",
  "required": ["id", "record_type", "target", "result"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "record_type": { "const": "assessment" },
    "target": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "result": { "type": "string" },
    "assessor": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "method": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/canonicalId" } },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false
}
