{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/common.schema.json",
  "$defs": {
    "canonicalId": {
      "type": "string",
      "pattern": "^mw:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)+$"
    },
    "label": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "language": { "type": "string" },
        "script": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
