{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/entity.schema.json",
  "type": "object",
  "required": ["id", "record_type", "kind"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "record_type": { "const": "entity" },
    "kind": { "type": "string", "minLength": 1 },
    "labels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/label" } },
    "description": { "type": "string" },
    "lifecycle": { "$ref": "common.schema.json#/$defs/recordLifecycle" },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false
}
