{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/evidence.schema.json",
  "type": "object",
  "required": ["id", "record_type", "target", "relation"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "record_type": { "const": "evidence" },
    "target": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "relation": { "type": "string" },
    "selector": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" } }, "additionalProperties": true },
    "provenance": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false
}
