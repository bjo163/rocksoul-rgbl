{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/provenance.schema.json",
  "$defs": {
    "activity": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["acquisition", "parsing", "normalization", "mapping", "curation", "reconciliation", "validation", "generation", "other"] },
        "method": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "agent": { "$ref": "common.schema.json#/$defs/canonicalId" },
        "software": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
            "version": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
          },
          "additionalProperties": false
        },
        "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
        "ended_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
        "note": { "type": "string", "minLength": 1 },
        "extensions": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["id", "record_type", "source", "activities"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "record_type": { "const": "provenance" },
    "source": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "source_reference": { "type": "string" },
    "activities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/activity" } },
    "lifecycle": { "$ref": "common.schema.json#/$defs/recordLifecycle" },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false
}
