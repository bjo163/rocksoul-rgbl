{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/provenance.schema.json",
  "type": "object",
  "required": ["id", "record_type", "source"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "record_type": { "const": "provenance" },
    "source": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "source_reference": { "type": "string" },
    "activity": { "type": "object" },
    "lifecycle": { "$ref": "common.schema.json#/$defs/recordLifecycle" },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false
}
