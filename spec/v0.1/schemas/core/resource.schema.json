{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json",
  "type": "object",
  "required": ["id", "record_type", "kind"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonicalId" },
    "record_type": { "const": "resource" },
    "kind": { "type": "string", "minLength": 1 },
    "labels": { "type": "array", "items": { "type": "object", "required": ["value"], "properties": { "value": { "type": "string" }, "language": { "type": "string" }, "script": { "type": "string" } }, "additionalProperties": false } },
    "description": { "type": "string" },
    "lifecycle": { "$ref": "common.schema.json#/$defs/recordLifecycle" },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false
}
