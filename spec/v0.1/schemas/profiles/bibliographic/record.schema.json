{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/bibliographic/record.schema.json",
  "allOf": [
    { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" },
    {
      "required": ["extensions"],
      "properties": {
        "kind": { "const": "bibliographic.record" },
        "extensions": {
          "type": "object",
          "required": ["bibliographic"],
          "properties": {
            "bibliographic": {
              "type": "object",
              "required": ["title", "resource_type"],
              "properties": {
                "title": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "subtitle": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "resource_type": { "enum": ["work", "expression", "edition", "article", "chapter", "catalog_record", "web_resource", "other"] },
                "authors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/canonicalId" } },
                "editors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/canonicalId" } },
                "publisher": { "$ref": "common.schema.json#/$defs/canonicalId" },
                "publication_place": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "publication_date": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "edition_statement": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "identifiers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/externalIdentifier" } },
                "source": { "$ref": "common.schema.json#/$defs/canonicalId" },
                "provenance": { "$ref": "common.schema.json#/$defs/canonicalId" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
