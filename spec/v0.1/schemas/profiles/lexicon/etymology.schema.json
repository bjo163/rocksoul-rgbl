{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/lexicon/etymology.schema.json",
  "allOf": [{ "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" }, { "required": ["extensions"], "properties": { "kind": { "const": "lexicon.etymology" }, "extensions": { "type": "object", "required": ["lexicon"], "properties": { "lexicon": { "type": "object", "required": ["term", "statement", "certainty", "provenance"], "properties": { "term": { "$ref": "common.schema.json#/$defs/canonicalId" }, "source_forms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/canonicalId" } }, "statement": { "$ref": "common.schema.json#/$defs/nonBlankString" }, "certainty": { "enum": ["attested", "probable", "possible", "reconstructed", "disputed"] }, "scope": { "$ref": "common.schema.json#/$defs/scope" }, "provenance": { "$ref": "common.schema.json#/$defs/canonicalId" } }, "additionalProperties": false } }, "additionalProperties": false } } }]
}
