{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/lineage/common.schema.json",
  "$defs": {
    "canonicalId": { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/common.schema.json#/$defs/canonicalId" },
    "nonBlankString": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "references": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/canonicalId" } }
  }
}
