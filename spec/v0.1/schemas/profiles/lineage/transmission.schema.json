{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/lineage/transmission.schema.json",
  "allOf": [
    { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" },
    { "required": ["extensions"], "properties": { "kind": { "const": "lineage.transmission" }, "extensions": { "type": "object", "required": ["lineage"], "properties": { "lineage": { "type": "object", "required": ["from", "to", "relation"], "properties": { "from": { "$ref": "common.schema.json#/$defs/canonicalId" }, "to": { "$ref": "common.schema.json#/$defs/canonicalId" }, "relation": { "enum": ["transmitted_by", "derived_from", "taught_by", "descends_from", "preserved_by", "associated_with"] }, "sequence": { "type": "integer", "minimum": 1 }, "generation": { "type": "integer", "minimum": 1 }, "evidence": { "$ref": "common.schema.json#/$defs/references" }, "provenance": { "$ref": "common.schema.json#/$defs/canonicalId" }, "note": { "$ref": "common.schema.json#/$defs/nonBlankString" } }, "additionalProperties": false } }, "additionalProperties": false } } }
  ]
}
