{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/manuscript/witness.schema.json",
  "allOf": [
    { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" },
    {
      "required": ["extensions"],
      "properties": {
        "kind": { "const": "manuscript.witness" },
        "extensions": {
          "type": "object",
          "required": ["manuscript"],
          "properties": {
            "manuscript": {
              "type": "object",
              "required": ["witness_type", "shelfmark"],
              "properties": {
                "witness_type": { "enum": ["manuscript", "inscription", "print", "digital_scan", "other"] },
                "repository": { "$ref": "common.schema.json#/$defs/canonicalId" },
                "collection": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "shelfmark": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "target": { "$ref": "common.schema.json#/$defs/canonicalId" },
                "folio": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "side": { "enum": ["recto", "verso", "single", "unknown"] },
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 },
                "siglum": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "note": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "provenance": { "$ref": "common.schema.json#/$defs/canonicalId" }
              },
              "additionalProperties": false,
              "allOf": [{ "if": { "required": ["line_end"] }, "then": { "required": ["line_start"] } }]
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
