{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/media/iiif-artifact.schema.json",
  "allOf": [
    { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" },
    {
      "required": ["extensions"],
      "properties": {
        "kind": { "const": "media.iiif_artifact" },
        "extensions": {
          "type": "object",
          "required": ["iiif"],
          "properties": {
            "iiif": {
              "type": "object",
              "required": ["manifest"],
              "properties": {
                "manifest": { "$ref": "common.schema.json#/$defs/absoluteUri" },
                "canvas": { "$ref": "common.schema.json#/$defs/absoluteUri" },
                "image": { "$ref": "common.schema.json#/$defs/absoluteUri" },
                "region": { "$ref": "common.schema.json#/$defs/absoluteUri" },
                "service": { "$ref": "common.schema.json#/$defs/absoluteUri" },
                "target": { "$ref": "common.schema.json#/$defs/canonicalId" },
                "format": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "label": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "note": { "$ref": "common.schema.json#/$defs/nonBlankString" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
