{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/media/selector.schema.json",
  "allOf": [
    { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" },
    {
      "required": ["extensions"],
      "properties": {
        "kind": { "const": "media.selector" },
        "extensions": {
          "type": "object",
          "required": ["media"],
          "properties": {
            "media": {
              "type": "object",
              "required": ["target", "media_type"],
              "properties": {
                "target": { "$ref": "common.schema.json#/$defs/canonicalId" },
                "media_type": { "enum": ["audio", "video", "image", "other"] },
                "fragment_uri": { "$ref": "common.schema.json#/$defs/absoluteUri" },
                "start_seconds": { "type": "number", "minimum": 0 },
                "end_seconds": { "type": "number", "minimum": 0 },
                "track": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "language": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "format": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "note": { "$ref": "common.schema.json#/$defs/nonBlankString" }
              },
              "additionalProperties": false,
              "allOf": [{ "if": { "required": ["end_seconds"] }, "then": { "required": ["start_seconds"] } }]
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
