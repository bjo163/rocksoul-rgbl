{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/scholarly/citation.schema.json",
  "allOf": [
    { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" },
    { "required": ["extensions"], "properties": { "kind": { "const": "scholarly.citation" }, "extensions": { "type": "object", "required": ["citation"], "properties": { "citation": { "type": "object", "required": ["citing", "cited", "citation_type"], "properties": { "citing": { "$ref": "common.schema.json#/$defs/canonicalId" }, "cited": { "$ref": "common.schema.json#/$defs/canonicalId" }, "citation_type": { "enum": ["supports", "discusses", "quotes", "translates", "edits", "references", "other"] }, "locator": { "$ref": "common.schema.json#/$defs/nonBlankString" }, "page": { "$ref": "common.schema.json#/$defs/nonBlankString" }, "quote": { "type": "string" }, "uri": { "$ref": "common.schema.json#/$defs/absoluteUri" }, "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/canonicalId" } }, "provenance": { "$ref": "common.schema.json#/$defs/canonicalId" } }, "additionalProperties": false } }, "additionalProperties": false } } }
  ]
}
