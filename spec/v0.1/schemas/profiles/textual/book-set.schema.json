{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/textual/book-set.schema.json",
  "allOf": [
    { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" },
    {
      "required": ["extensions"],
      "properties": {
        "kind": { "const": "textual.book_set" },
        "extensions": {
          "type": "object",
          "required": ["textual"],
          "properties": {
            "textual": {
              "type": "object",
              "required": ["edition", "members"],
              "properties": {
                "edition": { "$ref": "common.schema.json#/$defs/canonicalId" },
                "members": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {
                    "type": "object", "required": ["book", "sequence"],
                    "properties": {
                      "book": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                      "sequence": { "type": "integer", "minimum": 1 }
                    }, "additionalProperties": false
                  }
                }
              }, "additionalProperties": false
            }
          }
        }
      }
    }
  ]
}
