{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/textual/citation-scheme.schema.json",
  "allOf": [
    { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" },
    {
      "required": ["extensions"],
      "properties": {
        "kind": { "const": "textual.citation_scheme" },
        "extensions": {
          "type": "object",
          "required": ["textual"],
          "properties": {
            "textual": {
              "type": "object",
              "required": ["applies_to", "components"],
              "properties": {
                "applies_to": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "common.schema.json#/$defs/canonicalId" }
                },
                "components": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["key"],
                    "properties": {
                      "key": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                      "unit": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                      "optional": { "type": "boolean" }
                    },
                    "additionalProperties": false
                  }
                },
                "delimiter": { "type": "string" },
                "example": { "$ref": "common.schema.json#/$defs/nonBlankString" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  ]
}
