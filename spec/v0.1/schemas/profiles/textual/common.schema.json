{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/textual/common.schema.json",
  "$defs": {
    "canonicalId": {
      "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/common.schema.json#/$defs/canonicalId"
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[a-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "scriptTag": {
      "type": "string",
      "pattern": "^[A-Z][a-z]{3}$"
    },
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "textQuoteSelector": {
      "type": "object",
      "required": ["type", "exact"],
      "properties": {
        "type": { "const": "TextQuoteSelector" },
        "exact": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string" },
        "suffix": { "type": "string" }
      },
      "additionalProperties": false
    },
    "textPositionSelector": {
      "type": "object",
      "required": ["type", "start", "end"],
      "properties": {
        "type": { "const": "TextPositionSelector" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "selectorEndpoint": {
      "oneOf": [
        { "$ref": "#/$defs/textQuoteSelector" },
        { "$ref": "#/$defs/textPositionSelector" }
      ]
    },
    "rangeSelector": {
      "type": "object",
      "required": ["type", "startSelector", "endSelector"],
      "properties": {
        "type": { "const": "RangeSelector" },
        "startSelector": { "$ref": "#/$defs/selectorEndpoint" },
        "endSelector": { "$ref": "#/$defs/selectorEndpoint" }
      },
      "additionalProperties": false
    },
    "textSelector": {
      "oneOf": [
        { "$ref": "#/$defs/textQuoteSelector" },
        { "$ref": "#/$defs/textPositionSelector" },
        { "$ref": "#/$defs/rangeSelector" }
      ]
    },
    "textTarget": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": { "$ref": "#/$defs/canonicalId" },
        "selector": { "$ref": "#/$defs/textSelector" }
      },
      "additionalProperties": false
    },
    "citationReference": {
      "type": "object",
      "required": ["scheme", "reference", "path"],
      "properties": {
        "scheme": { "$ref": "#/$defs/canonicalId" },
        "reference": { "$ref": "#/$defs/nonBlankString" },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonBlankString" }
        }
      },
      "additionalProperties": false
    },
    "contentDerivation": {
      "type": "object",
      "required": ["content", "relation"],
      "properties": {
        "content": { "$ref": "#/$defs/canonicalId" },
        "relation": {
          "enum": [
            "translation",
            "transliteration",
            "normalization",
            "search_normalization",
            "transcription",
            "correction",
            "other"
          ]
        },
        "method": { "$ref": "#/$defs/nonBlankString" },
        "version": { "$ref": "#/$defs/nonBlankString" }
      },
      "additionalProperties": false
    }
  }
}
