{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/textual/edition.schema.json",
  "allOf": [
    { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" },
    {
      "required": ["extensions"],
      "properties": {
        "kind": { "const": "textual.edition" },
        "extensions": {
          "type": "object",
          "required": ["textual"],
          "properties": {
            "textual": {
              "type": "object",
              "required": ["expressions"],
              "properties": {
                "expressions": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "common.schema.json#/$defs/canonicalId" }
                },
                "edition_statement": { "$ref": "common.schema.json#/$defs/nonBlankString" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  ]
}
