{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/textual/passage.schema.json",
  "allOf": [
    { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" },
    {
      "required": ["extensions"],
      "properties": {
        "kind": { "const": "textual.passage" },
        "extensions": {
          "type": "object",
          "required": ["textual"],
          "properties": {
            "textual": {
              "type": "object",
              "required": ["container", "unit"],
              "properties": {
                "container": { "$ref": "common.schema.json#/$defs/canonicalId" },
                "parent": { "$ref": "common.schema.json#/$defs/canonicalId" },
                "unit": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "sequence": { "type": "integer", "minimum": 1 },
                "local_id": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "citations": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "common.schema.json#/$defs/citationReference" }
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  ]
}
