{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/textual/variant.schema.json",
  "allOf": [
    { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" },
    {
      "required": ["extensions"],
      "properties": {
        "kind": { "const": "textual.variant" },
        "extensions": {
          "type": "object",
          "required": ["textual"],
          "properties": {
            "textual": {
              "type": "object",
              "required": ["locus", "readings"],
              "properties": {
                "locus": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "common.schema.json#/$defs/textTarget" }
                },
                "readings": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": ["witnesses"],
                    "properties": {
                      "label": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                      "witnesses": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "$ref": "common.schema.json#/$defs/canonicalId" }
                      },
                      "content": { "$ref": "common.schema.json#/$defs/canonicalId" },
                      "text": { "type": "string" },
                      "language": { "$ref": "common.schema.json#/$defs/languageTag" },
                      "script": { "$ref": "common.schema.json#/$defs/scriptTag" }
                    },
                    "additionalProperties": false,
                    "oneOf": [
                      { "required": ["content"], "not": { "required": ["text"] } },
                      { "required": ["text"], "not": { "required": ["content"] } }
                    ]
                  }
                },
                "provenance": { "$ref": "common.schema.json#/$defs/canonicalId" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  ]
}
