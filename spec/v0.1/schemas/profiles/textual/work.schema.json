{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/corpus/spec/v0.1/schemas/profiles/textual/work.schema.json",
  "allOf": [
    { "$ref": "https://moonwitness.org/corpus/spec/v0.1/schemas/core/resource.schema.json" },
    {
      "required": ["extensions"],
      "properties": {
        "kind": { "const": "textual.work" },
        "extensions": {
          "type": "object",
          "required": ["textual"],
          "properties": {
            "textual": {
              "type": "object",
              "properties": {
                "work_type": { "$ref": "common.schema.json#/$defs/nonBlankString" },
                "part_of": { "$ref": "common.schema.json#/$defs/canonicalId" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  ]
}
